{
    "name": "langium-minilogo",
    "displayName": "MiniLogo",
    "icon": "icon.png",
    "type": "module",
    "keywords": [
        "minilogo",
        "langium",
        "typefox",
        "graphics"
    ],
    "publisher": "TypeFox",
    "description": "An implementation of the MiniLogo Language in Langium",
    "version": "4.0.0",
    "engines": {
        "node": ">=24"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "minilogo",
                "aliases": [
                    "Mini Logo",
                    "minilogo"
                ],
                "extensions": [
                    ".logo"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "minilogo",
                "scopeName": "source.minilogo",
                "path": "./syntaxes/minilogo.tmLanguage.json"
            }
        ]
    },
    "activationEvents": [
        "onLanguage:minilogo"
    ],
    "files": [
        "bin",
        "out",
        "src",
        "syntaxes"
    ],
    "bin": {
        "minilogo-cli": "bin/minilogo.js"
    },
    "exports": "./out/extension.cjs",
    "main": "./out/extension.cjs",
    "scripts": {
        "lint": "eslint src --ext ts",
        "clean": "rm -rf ./public && rm -rf ./out",
        "vscode:prepublish": "npm run langium:generate && npm run build:extension && npm run lint",
        "build": "npm run clean && npm run build:tsc && npm run build:web && npm run build:extension",
        "build:extension": "npm run esbuild:extension && npm run esbuild:ls",
        "esbuild:extension": "esbuild ./src/extension.ts --minify --bundle --outfile=out/extension.cjs --external:vscode --format=cjs --platform=node",
        "esbuild:ls": "esbuild ./src/language-server/main.ts --minify --bundle --outfile=out/language-server/main.cjs --format=cjs --platform=node",
        "build:web": "vite build",
        "build:tsc": "tsc -b tsconfig.json",
        "dev": "vite serve --config vite.config.ts",
        "watch": "tsc -b tsconfig.json --watch",
        "langium:generate": "langium generate",
        "langium:watch": "langium generate --watch",
        "generate:test": "./bin/minilogo.js generate ./examples/simple.logo",
        "generate:logo": "./bin/minilogo.js generate ./examples/langium.logo",
        "serve": "vite preview --config vite.config.ts"
    },
    "dependencies": {
        "chalk": "5.6.2",
        "commander": "~15.0.0",
        "langium": "~4.3.0",
        "monaco-languageclient": "~10.7.0",
        "vscode-jsonrpc": "~9.0.0",
        "vscode-languageclient": "~10.0.0",
        "vscode-languageserver": "~10.0.0",
        "vscode-languageserver-protocol": "~3.17.5",
        "vscode-languageserver-types": "~3.18.0"
    },
    "devDependencies": {
        "@types/node": "~24.1.0",
        "@types/vscode": "~1.120.0",
        "@typescript-eslint/eslint-plugin": "~8.61.1",
        "@typescript-eslint/parser": "~8.61.1",
        "esbuild": "~0.28.1",
        "eslint": "~10.5.0",
        "langium-cli": "~4.3.0",
        "typescript": "~6.0.3",
        "vite": "^8.0.16"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/langium/langium-minilogo.git"
    },
    "bugs": "https://github.com/langium/langium-minilogo/issues",
    "author": {
        "name": "TypeFox",
        "url": "https://www.typefox.io"
    }
}
